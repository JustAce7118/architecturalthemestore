<header class="header">
  <div class="header__inner">
    <h2 class="header__title">
      <a href="{{ routes.root_url }}">{{ shop.name | upcase }}</a>
    </h2>

    <nav class="header__menu">
      {% for link in section.settings.menu.links %}
      <div class="header__menu-item">
        {{ link.title | link_to: link.url }}
      </div>
      {% endfor %}
    </nav>

    <div class="header__icons">
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}">[ACCOUNT]</a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__cart-link">
        [CART: {{ cart.item_count }}]
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    border: 1px solid rgba(255, 255, 255, 0.4);
    position: sticky;
    top: 1rem; /* Detached from top */
    z-index: 1000;
    
    /* Ethereal Beam Style */
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    
    margin: 0 auto;
    width: 95%;
    max-width: var(--page-width);
    border-radius: 99px; /* Pill Shape */
    box-shadow: 
      0 4px 6px -1px rgba(0, 0, 0, 0.05),
      0 0 20px rgba(255, 255, 255, 0.5); /* Glowing Halo */
  }

  .header__inner {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    align-items: stretch;
    min-height: 3.5rem; /* Slimmer profile */
  }

  .header__title {
    margin: 0;
    display: flex;
    align-items: center;
    padding: 0 2rem;
    font-size: 1.1rem;
    letter-spacing: 1px;
  }

  .header__title a {
    text-decoration: none;
    font-weight: 700;
  }

  .header__menu {
    display: flex;
    justify-content: center; /* Center menu in the beam */
  }

  .header__menu-item {
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    font-size: 0.9rem;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }
  
  .header__menu-item:hover {
     opacity: 1;
     text-shadow: 0 0 10px rgba(255,255,255,0.8);
  }

  .header__icons {
    display: flex;
    align-items: center;
    padding-right: 1.5rem;
  }

  .header__icons a {
    display: flex;
    align-items: center;
    padding: 0 1rem;
    text-decoration: none;
    font-size: 0.9rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
