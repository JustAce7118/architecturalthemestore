<header class="header">
  <div class="header__inner">
    <h2 class="header__title">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: section.settings.logo_width | image_tag: loading: 'eager', class: 'header__logo-image', width: section.settings.logo.width, height: section.settings.logo.height }}
        {%- elsif section.settings.logo_text != blank -%}
          {{ section.settings.logo_text }}
        {%- else -%}
          {{ shop.name | upcase }}
        {%- endif -%}
      </a>
    </h2>

    <nav class="header__menu">
      {% for link in section.settings.menu.links %}
      <div class="header__menu-item">
        {{ link.title | link_to: link.url }}
      </div>
      {% endfor %}
    </nav>

    <div class="header__icons">
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}">[ACCOUNT]</a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__cart-link">
        [CART: {{ cart.item_count }}]
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    border: 1px solid rgba(255, 255, 255, 0.1);
    position: sticky;
    top: 1.5rem; /* Floating lower */
    z-index: 1000;
    
    /* Dark Structure Slab */
    background-color: var(--color-glass);
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
      background-blend-mode: multiply; /* Darken texture */
    {% endif %}
    
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    
    margin: 0 auto;
    width: 92%;
    max-width: var(--page-width);
    border-radius: 12px;
    box-shadow: 
      0 20px 50px -10px rgba(0, 0, 0, 0.5), /* Deep Black Shadow */
      0 1px 0 rgba(255, 255, 255, 0.1) inset;
  }

  .header__inner {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    align-items: stretch;
    min-height: 3.5rem; /* Slimmer profile */
  }

  .header__title {
    margin: 0;
    display: flex;
    align-items: center;
    padding: 0 2rem;
    font-size: 1.1rem;
    letter-spacing: 1px;
  }

  .header__title a {
    text-decoration: none;
    font-weight: 700;
  }

  .header__menu {
    display: flex;
    justify-content: center; /* Center menu in the beam */
  }

  .header__menu-item {
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    font-size: 0.9rem;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }
  
  .header__menu-item:hover {
     opacity: 1;
     text-shadow: 0 0 10px rgba(255,255,255,0.8);
  }

  .header__icons {
    display: flex;
    align-items: center;
    padding-right: 1.5rem;
  }

  .header__icons a {
    display: flex;
    align-items: center;
    padding: 0 1rem;
    text-decoration: none;
    font-size: 0.9rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Structure Texture (Building Image)"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "info": "Overrides the default shop name if no logo image is uploaded."
    },
    {
       "type": "range",
       "id": "logo_width",
       "min": 50,
       "max": 300,
       "step": 10,
       "unit": "px",
       "label": "Logo Width",
       "default": 120
    }
  ]
}
{% endschema %}
