<header class="header">
  <div class="header__inner">
    <h2 class="header__title">
      <a href="{{ routes.root_url }}">{{ shop.name | upcase }}</a>
    </h2>

    <nav class="header__menu">
      {% for link in section.settings.menu.links %}
      <div class="header__menu-item">
        {{ link.title | link_to: link.url }}
      </div>
      {% endfor %}
    </nav>

    <div class="header__icons">
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}">[ACCOUNT]</a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="header__cart-link">
        [CART: {{ cart.item_count }}]
      </a>
    </div>
  </div>
</header>

{% stylesheet %}
  .header {
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    /* Airy Translucent Effect */
    background-color: rgba(248, 249, 250, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header__inner {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    align-items: stretch;
    min-height: 4rem;
  }

  .header__title {
    margin: 0;
    border-right: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    font-size: 1.2rem;
    letter-spacing: 1px;
  }

  .header__title a {
    text-decoration: none;
    font-weight: 700;
  }

  .header__menu {
    display: flex;
    border-right: 1px solid var(--color-border);
  }

  .header__menu-item {
    border-right: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
  }
  
  .header__menu-item:last-child {
    border-right: none;
  }

  .header__icons {
    display: flex;
    align-items: stretch;
  }

  .header__icons a {
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    border-left: 1px solid var(--color-border);
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
