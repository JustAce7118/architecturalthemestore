{% comment %}
  Blueprint Client Transmissions
  - Testimonials styled as intercepted communications
  - Signal strength indicators & client metadata
  - Typing animation on reveal
{% endcomment %}

<div class="blueprint-transmissions">
  <div class="blueprint-transmissions__header">
    <h3 class="blueprint-transmissions__title">{{ section.settings.heading | default: 'CLIENT TRANSMISSIONS' | upcase }}</h3>
    <span class="blueprint-transmissions__meta">// SIGNAL_LOG — {{ section.blocks.size }} ENTRIES DECODED</span>
  </div>

  <div class="blueprint-transmissions__grid">
    {% for block in section.blocks %}
      <div class="transmission-card">
        <div class="transmission-card__header">
          <div class="transmission-card__signal">
            <span class="signal-bar {% if block.settings.signal_strength == '5' or block.settings.signal_strength == '4' or block.settings.signal_strength == '3' or block.settings.signal_strength == '2' or block.settings.signal_strength == '1' %}active{% endif %}"></span>
            <span class="signal-bar {% if block.settings.signal_strength == '5' or block.settings.signal_strength == '4' or block.settings.signal_strength == '3' or block.settings.signal_strength == '2' %}active{% endif %}"></span>
            <span class="signal-bar {% if block.settings.signal_strength == '5' or block.settings.signal_strength == '4' or block.settings.signal_strength == '3' %}active{% endif %}"></span>
            <span class="signal-bar {% if block.settings.signal_strength == '5' or block.settings.signal_strength == '4' %}active{% endif %}"></span>
            <span class="signal-bar {% if block.settings.signal_strength == '5' %}active{% endif %}"></span>
          </div>
          <span class="transmission-card__id">TX_{{ forloop.index | prepend: '00' | slice: -3, 3 }}</span>
        </div>

        <div class="transmission-card__body">
          <div class="transmission-card__quote">
            <span class="quote-prefix">&gt;</span>
            <p class="quote-text">{{ block.settings.quote }}</p>
          </div>
        </div>

        <div class="transmission-card__footer">
          <div class="transmission-card__source">
            {% if block.settings.avatar != blank %}
              <div class="source-avatar">
                {{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', class: 'source-avatar__img' }}
              </div>
            {% else %}
              <div class="source-avatar source-avatar--placeholder">
                <span>{{ block.settings.name | slice: 0 }}</span>
              </div>
            {% endif %}
            <div class="source-info">
              <span class="source-name">{{ block.settings.name | default: 'UNKNOWN' | upcase }}</span>
              <span class="source-role">{{ block.settings.role | default: 'CLIENT' }}</span>
            </div>
          </div>
          {% if block.settings.project_ref != blank %}
            <span class="transmission-card__project">PRJ: {{ block.settings.project_ref }}</span>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>
  .blueprint-transmissions {
    padding: 4rem 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .blueprint-transmissions__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
    max-width: var(--page-width);
    margin-left: auto;
    margin-right: auto;
  }

  .blueprint-transmissions__title {
    font-size: 1.2rem;
    margin: 0;
    color: var(--color-accent);
    letter-spacing: 2px;
  }

  .blueprint-transmissions__meta {
    font-size: 0.7rem;
    opacity: 0.4;
    animation: tx-blink 2.5s infinite;
  }

  @keyframes tx-blink {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.15; }
  }

  .blueprint-transmissions__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  /* Card */
  .transmission-card {
    border: 1px solid var(--color-border);
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s ease;
  }

  .transmission-card:hover {
    border-color: rgba(56, 189, 248, 0.3);
  }

  /* Card Header */
  .transmission-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    border-bottom: 1px dashed var(--color-border);
    background: rgba(56, 189, 248, 0.03);
  }

  .transmission-card__signal {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }

  .signal-bar {
    width: 3px;
    background: rgba(255, 255, 255, 0.15);
    display: block;
  }

  .signal-bar:nth-child(1) { height: 4px; }
  .signal-bar:nth-child(2) { height: 6px; }
  .signal-bar:nth-child(3) { height: 8px; }
  .signal-bar:nth-child(4) { height: 10px; }
  .signal-bar:nth-child(5) { height: 14px; }

  .signal-bar.active {
    background: var(--color-accent);
  }

  .transmission-card__id {
    font-size: 0.6rem;
    color: var(--color-accent);
    opacity: 0.5;
    letter-spacing: 1px;
  }

  /* Card Body */
  .transmission-card__body {
    padding: 1.5rem 1rem;
    flex-grow: 1;
  }

  .transmission-card__quote {
    display: flex;
    gap: 0.75rem;
  }

  .quote-prefix {
    color: var(--color-accent);
    font-size: 1.2rem;
    line-height: 1;
    flex-shrink: 0;
    opacity: 0.6;
  }

  .quote-text {
    font-size: 0.85rem;
    line-height: 1.7;
    opacity: 0.8;
    margin: 0;
    font-style: italic;
  }

  /* Card Footer */
  .transmission-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-top: 1px dashed var(--color-border);
  }

  .transmission-card__source {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .source-avatar {
    width: 32px;
    height: 32px;
    border: 1px solid var(--color-border);
    overflow: hidden;
    flex-shrink: 0;
  }

  .source-avatar__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.1);
  }

  .source-avatar--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(56, 189, 248, 0.1);
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .source-info {
    display: flex;
    flex-direction: column;
  }

  .source-name {
    font-size: 0.7rem;
    letter-spacing: 2px;
    color: var(--color-foreground);
  }

  .source-role {
    font-size: 0.6rem;
    opacity: 0.5;
    letter-spacing: 1px;
  }

  .transmission-card__project {
    font-size: 0.6rem;
    color: var(--color-accent);
    opacity: 0.5;
    letter-spacing: 1px;
  }

  @media screen and (max-width: 600px) {
    .blueprint-transmissions__grid {
      grid-template-columns: 1fr;
    }
    .blueprint-transmissions__header {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Client Transmissions",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CLIENT TRANSMISSIONS"
    }
  ],
  "blocks": [
    {
      "type": "transmission",
      "name": "Transmission",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote / Testimonial",
          "default": "The precision and attention to structural detail exceeded all expectations. A truly engineered masterpiece."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Client Name",
          "default": "ALEX MERCER"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Client Role / Company",
          "default": "CEO, NEXUS CORP"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Client Photo"
        },
        {
          "type": "text",
          "id": "project_ref",
          "label": "Project Reference",
          "default": "NX-2024"
        },
        {
          "type": "select",
          "id": "signal_strength",
          "label": "Signal Strength (visual)",
          "options": [
            { "value": "1", "label": "1 Bar" },
            { "value": "2", "label": "2 Bars" },
            { "value": "3", "label": "3 Bars" },
            { "value": "4", "label": "4 Bars" },
            { "value": "5", "label": "5 Bars (Full)" }
          ],
          "default": "5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Client Transmissions",
      "blocks": [
        { "type": "transmission", "settings": { "quote": "The precision and attention to structural detail exceeded all expectations.", "name": "ALEX MERCER", "role": "CEO, NEXUS CORP", "project_ref": "NX-2024", "signal_strength": "5" } },
        { "type": "transmission", "settings": { "quote": "From concept to completion, every phase was documented and delivered with military-grade precision.", "name": "SARAH CHEN", "role": "DIRECTOR, APEX STUDIO", "project_ref": "AP-2023", "signal_strength": "4" } },
        { "type": "transmission", "settings": { "quote": "A seamless integration of form and function. The engineering speaks for itself.", "name": "JAMES OKORO", "role": "LEAD ARCHITECT, VERTEX", "project_ref": "VX-2024", "signal_strength": "5" } }
      ]
    }
  ]
}
{% endschema %}
