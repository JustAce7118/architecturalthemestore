<footer class="footer">
  <div class="footer__grid">
    <!-- 1. Branding Block -->
    <div class="footer__block footer__block--branding">
      <h3 class="footer__heading">
        {%- if section.settings.footer_logo != blank -%}
          {{ section.settings.footer_logo | image_url: width: section.settings.footer_logo_width | image_tag: loading: 'lazy', class: 'footer__logo-image', width: section.settings.footer_logo.width, height: section.settings.footer_logo.height }}
        {%- endif -%}

        {%- if section.settings.footer_logo_text != blank -%}
          <span style="display: block; margin-top: 5px; color: {{ section.settings.footer_logo_text_color }};">// {{ section.settings.footer_logo_text }} //</span>
        {%- endif -%}

        {%- if section.settings.footer_logo == blank and section.settings.footer_logo_text == blank -%}
          // {{ shop.name | upcase }} //
        {%- endif -%}
      </h3>
      <p class="footer__status">STATUS: ONLINE</p>
    </div>

    <!-- 2. Menu Block -->
    <div class="footer__block footer__block--menu">
      <ul class="footer__menu-list">
        {% for link in section.settings.menu.links %}
          <li>{{ link.title | link_to: link.url }}</li>
        {% endfor %}
      </ul>
    </div>

    <!-- 3. Newsletter Block -->
    <div class="footer__block footer__block--newsletter">
      <h3 class="footer__heading">{{ section.settings.newsletter_heading | default: 'NEWSLETTER' }}</h3>
      <div class="footer__newsletter-content">
        <p class="footer__newsletter-text">{{ section.settings.newsletter_text | default: 'Subscribe for updates.' }}</p>
        {% form 'customer', class: 'footer__newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-input-group">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="newsletter-input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="Newsletter-error--{{ section.id }}"
              {% elsif form.posted_successfully? %}
                aria-describedby="Newsletter-success--{{ section.id }}"
              {% endif %}
              placeholder="Email address"
              required
            >
            <button type="submit" class="newsletter-button" name="commit" aria-label="Subscribe">
              &rarr;
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-message error">{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</small>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <small class="newsletter-message success">Success!</small>
          {%- endif -%}
        {% endform %}
      </div>
    </div>

    <!-- 4. System/Social Block -->
    <div class="footer__block footer__block--system">
      <div class="architectural-feature">
        <div class="arch-icon {{ section.settings.feature_icon }}"></div>
        <div class="arch-data">
          <span class="arch-label">{{ section.settings.feature_heading | default: 'COORDINATES' }}</span>
          <span class="arch-value">{{ section.settings.feature_text | default: '34.0522° N, 118.2437° W' }}</span>
        </div>
      </div>
      
      <div class="footer__socials">
        {%- if section.settings.social_instagram != blank -%}
          <a href="{{ section.settings.social_instagram }}" class="social-link" title="Instagram" target="_blank">IG</a>
        {%- endif -%}
        {%- if section.settings.social_facebook != blank -%}
          <a href="{{ section.settings.social_facebook }}" class="social-link" title="Facebook" target="_blank">FB</a>
        {%- endif -%}
        {%- if section.settings.social_twitter != blank -%}
          <a href="{{ section.settings.social_twitter }}" class="social-link" title="Twitter" target="_blank">TW</a>
        {%- endif -%}
        {%- if section.settings.social_linkedin != blank -%}
          <a href="{{ section.settings.social_linkedin }}" class="social-link" title="LinkedIn" target="_blank">LI</a>
        {%- endif -%}
      </div>
    </div>
  </div>
  
  <div class="footer__bottom">
     {% if section.settings.copyright_text != blank %}
       <div class="footer__copyright-custom">{{ section.settings.copyright_text }}</div>
     {% else %}
       <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} {{ section.settings.copyright_notice }}</p>
     {% endif %}
  </div>
</footer>

{% stylesheet %}
  .footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding-top: 0;
    background-color: var(--color-background);
    position: relative;
    z-index: 1;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr; /* 4 Columns */
    border-bottom: 1px solid var(--color-border);
  }
  
  @media screen and (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__block:nth-child(even) {
      border-right: none;
    }
    .footer__block:nth-child(odd) {
      border-right: 1px solid var(--color-border);
    }
  }

  @media screen and (max-width: 600px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
    .footer__block {
      border-right: none !important;
      border-bottom: 1px solid var(--color-border);
    }
  }

  .footer__block {
    padding: 2rem;
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }

  .footer__block:last-child {
    border-right: none;
  }

  .footer__heading {
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: 700;
  }
  
  .footer__status {
    font-size: 0.8rem;
    opacity: 0.7;
    margin-top: auto; /* Push to bottom */
  }

  .footer__menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__menu-list li {
    margin-bottom: 0.5rem;
  }

  .footer__menu-list a {
    text-decoration: none;
  }

  /* Newsletter Styles */
  .footer__newsletter-text {
    font-size: 0.9rem;
    margin-bottom: 1rem;
    opacity: 0.8;
  }
  
  .newsletter-input-group {
    display: flex;
    border: 1px solid var(--color-foreground);
  }
  
  .newsletter-input {
    flex-grow: 1;
    border: none;
    padding: 0.5rem;
    background: transparent;
    color: inherit;
    font-family: inherit;
    font-size: 0.9rem;
    min-width: 0; /* Fix flex overflow */
  }
  
  .newsletter-input:focus {
    outline: none;
    background-color: rgba(var(--color-foreground-rgb), 0.05);
  }
  
  .newsletter-button {
    background: transparent;
    border: none;
    border-left: 1px solid var(--color-foreground);
    padding: 0 1rem;
    cursor: pointer;
    color: inherit;
    font-size: 1.2rem;
    line-height: 1;
  }
  
  .newsletter-button:hover {
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .newsletter-message {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }
  
  .newsletter-message.error { color: red; }
  .newsletter-message.success { color: green; }

  /* System/Social Block */
  .footer__block--system {
    justify-content: space-between;
    background-color: var(--color-foreground, #000);
    color: var(--color-background, #fff);
    position: relative;
    overflow: hidden;
  }

  .architectural-feature {
    display: flex;
    align-items: center;
    gap: 15px;
    font-family: monospace;
    z-index: 2;
    margin-bottom: 2rem;
  }

  .arch-icon {
    width: 12px;
    height: 12px;
    background-color: currentColor;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  
  .arch-icon.grid {
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 0;
    width: 16px; 
    height: 16px;
    background-image: linear-gradient(currentColor 1px, transparent 1px), linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: 4px 4px;
    animation: none;
  }

  .arch-icon.pulse {
     /* default styles apply */
  }

  .arch-icon.dot {
    animation: none;
  }
  
  .arch-icon.none {
    display: none;
  }

  .arch-data {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .arch-label {
    font-size: 0.65rem;
    opacity: 0.7;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }

  .arch-value {
    font-size: 0.9rem;
    font-weight: bold;
    letter-spacing: 0.5px;
  }
  
  .footer__socials {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    z-index: 2;
  }
  
  .social-link {
    color: inherit;
    text-decoration: none;
    font-family: monospace;
    font-size: 0.9rem;
    border: 1px solid currentColor;
    padding: 0.2rem 0.5rem;
    transition: all 0.2s ease;
  }
  
  .social-link:hover {
    background-color: currentColor;
    color: var(--color-foreground, #000); /* Invert */
  }

  .footer__bottom {
    padding: 1rem 2rem;
    font-size: 0.8rem;
    text-align: left;
  }
  
  .footer__copyright-custom p {
    margin: 0;
  }

  @keyframes pulse {
    0% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.1); }
    100% { opacity: 0.4; transform: scale(0.9); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "footer_logo_text",
      "label": "Footer Logo Text",
      "info": "Overrides the default shop name if no footer logo is uploaded."
    },
    {
      "type": "color",
      "id": "footer_logo_text_color",
      "label": "Footer Logo Text Color",
      "default": "#ffffff"
    },
    {
       "type": "range",
       "id": "footer_logo_width",
       "min": 50,
       "max": 300,
       "step": 10,
       "unit": "px",
       "label": "Footer Logo Width",
       "default": 120
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "NEWSLETTER"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter Text",
      "default": "Subscribe for updates."
    },
    {
      "type": "header",
      "content": "Architectural Feature",
      "info": "Replaces the system status box."
    },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "Feature Label",
      "default": "COORDINATES"
    },
    {
      "type": "text",
      "id": "feature_text",
      "label": "Feature Data",
      "default": "34.0522° N, 118.2437° W"
    },
    {
      "type": "select",
      "id": "feature_icon",
      "label": "Feature Icon",
      "options": [
        { "value": "pulse", "label": "Pulsing Dot" },
        { "value": "grid", "label": "Grid Block" },
        { "value": "dot", "label": "Static Dot" },
        { "value": "none", "label": "None" }
      ],
      "default": "pulse"
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram Link"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook Link"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter/X Link"
    },
    {
      "type": "url",
      "id": "social_linkedin",
      "label": "LinkedIn Link"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
       "type": "richtext",
       "id": "copyright_text",
       "label": "Custom Copyright Text",
       "info": "Overrides the entire copyright line."
    },
    {
       "type": "text",
       "id": "copyright_notice",
       "label": "Rights Notice",
       "default": "[ALL RIGHTS RESERVED]",
       "info": "Appended to the default copyright (Year + Store Name)."
    }
  ]
}
{% endschema %}
