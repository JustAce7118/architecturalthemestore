<footer class="footer">
  <div class="footer__grid">
    <div class="footer__block footer__block--branding">
      <h3 class="footer__heading">
        {%- if section.settings.footer_logo != blank -%}
          {{ section.settings.footer_logo | image_url: width: section.settings.footer_logo_width | image_tag: loading: 'lazy', class: 'footer__logo-image', width: section.settings.footer_logo.width, height: section.settings.footer_logo.height }}
        {%- endif -%}

        {%- if section.settings.footer_logo_text != blank -%}
          <span style="display: block; margin-top: 5px; color: {{ section.settings.footer_logo_text_color }};">// {{ section.settings.footer_logo_text }} //</span>
        {%- endif -%}

        {%- if section.settings.footer_logo == blank and section.settings.footer_logo_text == blank -%}
          // {{ shop.name | upcase }} //
        {%- endif -%}
      </h3>
      <p class="footer__status">STATUS: ONLINE</p>
    </div>

    <div class="footer__block footer__block--menu">
      <ul class="footer__menu-list">
        {% for link in section.settings.menu.links %}
          <li>{{ link.title | link_to: link.url }}</li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer__block footer__block--system">
      <div class="architectural-feature">
        <div class="arch-icon {{ section.settings.feature_icon }}"></div>
        <div class="arch-data">
          <span class="arch-label">{{ section.settings.feature_heading | default: 'COORDINATES' }}</span>
          <span class="arch-value">{{ section.settings.feature_text | default: '34.0522° N, 118.2437° W' }}</span>
        </div>
      </div>
    </div>
  </div>
  
  <div class="footer__bottom">
     {% if section.settings.copyright_text != blank %}
       <div class="footer__copyright-custom">{{ section.settings.copyright_text }}</div>
     {% else %}
       <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} {{ section.settings.copyright_notice }}</p>
     {% endif %}
  </div>
</footer>

{% stylesheet %}
  .footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding-top: 0;
    background-color: var(--color-background);
    position: relative;
    z-index: 1;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-bottom: 1px solid var(--color-border);
  }

  .footer__block {
    padding: 2rem;
    border-right: 1px solid var(--color-border);
  }

  .footer__block:last-child {
    border-right: none;
  }

  .footer__heading {
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: 700;
  }
  
  .footer__status {
    font-size: 0.8rem;
    opacity: 0.7;
    margin-top: 0.5rem;
  }

  .footer__menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__menu-list li {
    margin-bottom: 0.5rem;
  }

  .footer__menu-list a {
    text-decoration: none;
  }

  .footer__block--system {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-foreground, #000); /* Fallback to black if var missing */
    color: var(--color-background, #fff);
    position: relative;
    overflow: hidden;
  }

  .architectural-feature {
    display: flex;
    align-items: center;
    gap: 15px;
    font-family: monospace;
    z-index: 2;
  }

  .arch-icon {
    width: 12px;
    height: 12px;
    background-color: currentColor;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  
  .arch-icon.grid {
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 0;
    width: 16px; 
    height: 16px;
    background-image: linear-gradient(currentColor 1px, transparent 1px), linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: 4px 4px;
    animation: none;
  }

  .arch-icon.pulse {
     /* default styles apply */
  }

  .arch-icon.dot {
    animation: none;
  }
  
  .arch-icon.none {
    display: none;
  }

  .arch-data {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .arch-label {
    font-size: 0.65rem;
    opacity: 0.7;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }

  .arch-value {
    font-size: 0.9rem;
    font-weight: bold;
    letter-spacing: 0.5px;
  }

  .footer__bottom {
    padding: 1rem 2rem;
    font-size: 0.8rem;
    text-align: left;
  }
  
  .footer__copyright-custom p {
    margin: 0;
  }

  @keyframes pulse {
    0% { opacity: 0.4; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.1); }
    100% { opacity: 0.4; transform: scale(0.9); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "footer_logo_text",
      "label": "Footer Logo Text",
      "info": "Overrides the default shop name if no footer logo is uploaded."
    },
    {
      "type": "color",
      "id": "footer_logo_text_color",
      "label": "Footer Logo Text Color",
      "default": "#ffffff"
    },
    {
       "type": "range",
       "id": "footer_logo_width",
       "min": 50,
       "max": 300,
       "step": 10,
       "unit": "px",
       "label": "Footer Logo Width",
       "default": 120
    },
    {
      "type": "header",
      "content": "Architectural Feature",
      "info": "Replaces the system status box."
    },
    {
      "type": "text",
      "id": "feature_heading",
      "label": "Feature Label",
      "default": "COORDINATES"
    },
    {
      "type": "text",
      "id": "feature_text",
      "label": "Feature Data",
      "default": "34.0522° N, 118.2437° W"
    },
    {
      "type": "select",
      "id": "feature_icon",
      "label": "Feature Icon",
      "options": [
        { "value": "pulse", "label": "Pulsing Dot" },
        { "value": "grid", "label": "Grid Block" },
        { "value": "dot", "label": "Static Dot" },
        { "value": "none", "label": "None" }
      ],
      "default": "pulse"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
       "type": "richtext",
       "id": "copyright_text",
       "label": "Custom Copyright Text",
       "info": "Overrides the entire copyright line."
    },
    {
       "type": "text",
       "id": "copyright_notice",
       "label": "Rights Notice",
       "default": "[ALL RIGHTS RESERVED]",
       "info": "Appended to the default copyright (Year + Store Name)."
    }
  ]
}
{% endschema %}
