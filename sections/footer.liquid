<footer class="footer">
  <div class="footer__grid">
    <div class="footer__block footer__block--branding">
      <h3 class="footer__heading">
        {%- if section.settings.footer_logo != blank -%}
          {{ section.settings.footer_logo | image_url: width: section.settings.footer_logo_width | image_tag: loading: 'lazy', class: 'footer__logo-image', width: section.settings.footer_logo.width, height: section.settings.footer_logo.height }}
        {%- elsif section.settings.footer_logo_text != blank -%}
          // {{ section.settings.footer_logo_text }} //
        {%- else -%}
          // {{ shop.name | upcase }} //
        {%- endif -%}
      </h3>
      <p class="footer__status">STATUS: ONLINE</p>
    </div>

    <div class="footer__block footer__block--menu">
      <ul class="footer__menu-list">
        {% for link in section.settings.menu.links %}
          <li>{{ link.title | link_to: link.url }}</li>
        {% endfor %}
      </ul>
    </div>

    {% if section.settings.show_system_status %}
    <div class="footer__block footer__block--system">
      <p class="system-ready-text">// SYSTEM_READY //</p>
    </div>
    {% endif %}
  </div>
  
  <div class="footer__bottom">
     <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} [ALL RIGHTS RESERVED]</p>
  </div>
</footer>

{% stylesheet %}
  .footer {
    border-top: 1px solid var(--color-border);
    margin-top: 4rem;
    padding-top: 0;
    background-color: var(--color-background);
    position: relative;
    z-index: 1;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-bottom: 1px solid var(--color-border);
  }

  .footer__block {
    padding: 2rem;
    border-right: 1px solid var(--color-border);
  }

  .footer__block:last-child {
    border-right: none;
  }

  .footer__heading {
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: 700;
  }
  
  .footer__status {
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .footer__menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__menu-list li {
    margin-bottom: 0.5rem;
  }

  .footer__menu-list a {
    text-decoration: none;
  }

  .footer__block--system {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-foreground);
    color: var(--color-background);
  }

  .system-ready-text {
    font-weight: bold;
    font-size: 1.2rem;
    letter-spacing: 2px;
    animation: blink 2s infinite;
  }

  .footer__bottom {
    padding: 1rem 2rem;
    font-size: 0.8rem;
    text-align: left;
  }

  @keyframes blink {
    0% { opacity: 1; }
    50% { opacity: 0; }
    100% { opacity: 1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "footer_logo_text",
      "label": "Footer Logo Text",
      "info": "Overrides the default shop name if no footer logo is uploaded."
    },
    {
       "type": "range",
       "id": "footer_logo_width",
       "min": 50,
       "max": 300,
       "step": 10,
       "unit": "px",
       "label": "Footer Logo Width",
       "default": 120
    },
    {
      "type": "checkbox",
      "id": "show_system_status",
      "label": "Show System Ready Block",
      "default": true,
      "info": "Controls the visibility of the white status box."
    }
  ]
}
{% endschema %}
