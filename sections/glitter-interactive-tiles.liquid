{%- liquid
  assign border_color = section.settings.border_color
  assign border_thickness = section.settings.border_thickness
  assign grid_gap = section.settings.grid_gap
  assign text_color = section.settings.text_color
  assign font_size = section.settings.font_size
  assign text_position = section.settings.text_position
  assign button_text = section.settings.button_text
  assign button_bg = section.settings.button_bg
  assign button_text_color = section.settings.button_text_color
-%}

<div class="editorial-grid" style="--border-color: {{ border_color }}; --border-thickness: {{ border_thickness }}px; --grid-gap: {{ grid_gap }}px; --text-color: {{ text_color }}; --font-size: {{ font_size }}px; --button-bg: {{ button_bg }}; --button-text-color: {{ button_text_color }};">
  <div class="editorial-grid__container">
    <!-- LEFT: Feature Tile (60%) -->
    {% if section.blocks.size > 0 %}
      {% assign feature_block = section.blocks[0] %}
      <div class="editorial-grid__feature" {{ feature_block.shopify_attributes }}>
        <div class="editorial-grid__media">
          {%- if feature_block.settings.video != blank -%}
            <video class="editorial-grid__video" autoplay muted loop playsinline>
              <source src="{{ feature_block.settings.video.sources[0].url }}" type="video/mp4">
            </video>
          {%- elsif feature_block.settings.image != blank -%}
            <img src="{{ feature_block.settings.image | image_url: width: 1000, height: 1200 }}" alt="{{ feature_block.settings.heading }}" class="editorial-grid__image" loading="lazy">
          {%- else -%}
            <div class="editorial-grid__placeholder">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'editorial-grid__placeholder-svg' }}
            </div>
          {%- endif -%}
        </div>

        <!-- Overlay Text -->
        <div class="editorial-grid__overlay editorial-grid__overlay--{{ text_position }}">
          <div class="editorial-grid__content">
            <h3 class="editorial-grid__heading">{{ feature_block.settings.heading }}</h3>
            {%- if feature_block.settings.button_url != blank -%}
              <a href="{{ feature_block.settings.button_url }}" class="editorial-grid__button">{{ button_text }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {% endif %}

    <!-- RIGHT: Stacked Tiles (40%) -->
    <div class="editorial-grid__stack">
      {% for block in section.blocks offset: 1 limit: 2 %}
        <div class="editorial-grid__tile" {{ block.shopify_attributes }}>
          <div class="editorial-grid__media">
            {%- if block.settings.video != blank -%}
              <video class="editorial-grid__video" autoplay muted loop playsinline>
                <source src="{{ block.settings.video.sources[0].url }}" type="video/mp4">
              </video>
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600, height: 500 }}" alt="{{ block.settings.heading }}" class="editorial-grid__image" loading="lazy">
            {%- else -%}
              <div class="editorial-grid__placeholder">
                {{ 'lifestyle-2' | placeholder_svg_tag: 'editorial-grid__placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>

          <!-- Overlay Text -->
          <div class="editorial-grid__overlay editorial-grid__overlay--{{ text_position }}">
            <div class="editorial-grid__content">
              <h3 class="editorial-grid__heading">{{ block.settings.heading }}</h3>
              {%- if block.settings.button_url != blank -%}
                <a href="{{ block.settings.button_url }}" class="editorial-grid__button">{{ button_text }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  /* MAIN CONTAINER */
  .editorial-grid {
    width: 100%;
    background-color: #ffffff;
  }

  .editorial-grid__container {
    display: grid;
    grid-template-columns: 60% 40%;
    gap: var(--grid-gap);
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 24px;
    align-items: stretch;
  }

  /* FEATURE TILE (Left) */
  .editorial-grid__feature {
    position: relative;
    aspect-ratio: 3 / 4;
    border: var(--border-thickness) solid var(--border-color);
    overflow: hidden;
  }

  /* STACKED TILES (Right) */
  .editorial-grid__stack {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: var(--grid-gap);
  }

  .editorial-grid__tile {
    position: relative;
    aspect-ratio: 1 / 1;
    border: var(--border-thickness) solid var(--border-color);
    overflow: hidden;
  }

  /* MEDIA */
  .editorial-grid__media {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .editorial-grid__image,
  .editorial-grid__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .editorial-grid__feature:hover .editorial-grid__image,
  .editorial-grid__feature:hover .editorial-grid__video,
  .editorial-grid__tile:hover .editorial-grid__image,
  .editorial-grid__tile:hover .editorial-grid__video {
    transform: scale(1.05);
  }

  .editorial-grid__placeholder {
    width: 100%;
    height: 100%;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .editorial-grid__placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.2;
  }

  /* OVERLAY - Text Container */
  .editorial-grid__overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    padding: 32px;
    z-index: 2;
    background-color: rgba(0, 0, 0, 0.4);
    transition: background-color 0.3s ease;
  }

  .editorial-grid__feature:hover .editorial-grid__overlay,
  .editorial-grid__tile:hover .editorial-grid__overlay {
    background-color: rgba(0, 0, 0, 0.6);
  }

  /* Text Position Variants */
  .editorial-grid__overlay--top {
    align-items: flex-start;
    justify-content: center;
  }

  .editorial-grid__overlay--center {
    align-items: center;
    justify-content: center;
  }

  .editorial-grid__overlay--bottom {
    align-items: flex-end;
    justify-content: center;
  }

  /* CONTENT BOX */
  .editorial-grid__content {
    text-align: center;
    max-width: 85%;
  }

  /* HEADING */
  .editorial-grid__heading {
    margin: 0 0 16px 0;
    font-family: 'Georgia', 'Garamond', serif;
    font-size: var(--font-size);
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--text-color);
    text-transform: uppercase;
    line-height: 1.2;
  }

  /* BUTTON - Gold Glitter Hover */
  .editorial-grid__button {
    display: inline-block;
    padding: 12px 36px;
    background-color: transparent;
    color: var(--text-color);
    border: 1px solid var(--text-color);
    border-radius: 0;
    font-family: 'Segoe UI', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.4s ease;
    position: relative;
  }

  .editorial-grid__button:hover {
    background-color: var(--button-bg);
    color: var(--button-text-color);
    border-color: var(--button-bg);
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.5);
    letter-spacing: 0.15em;
  }

  /* RESPONSIVE: TABLET */
  @media (max-width: 1024px) {
    .editorial-grid__container {
      grid-template-columns: 1fr;
      gap: var(--grid-gap);
      padding: 32px 20px;
    }

    .editorial-grid__feature {
      aspect-ratio: 16 / 9;
    }

    .editorial-grid__stack {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }

    .editorial-grid__tile {
      aspect-ratio: 1 / 1;
    }

    .editorial-grid__heading {
      font-size: calc(var(--font-size) * 0.9);
    }
  }

  /* RESPONSIVE: MOBILE */
  @media (max-width: 480px) {
    .editorial-grid__container {
      grid-template-columns: 1fr;
      gap: calc(var(--grid-gap) * 0.75);
      padding: 24px 16px;
    }

    .editorial-grid__feature {
      aspect-ratio: 4 / 5;
    }

    .editorial-grid__stack {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }

    .editorial-grid__tile {
      aspect-ratio: 4 / 5;
    }

    .editorial-grid__overlay {
      padding: 24px;
    }

    .editorial-grid__heading {
      font-size: calc(var(--font-size) * 0.75);
      margin-bottom: 12px;
    }

    .editorial-grid__button {
      padding: 10px 28px;
      font-size: 0.65rem;
    }
  }
</style>

{% schema %}
{
  "name": "Editorial Motion Grid",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Poster Image (fallback)"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Upload Video (MP4)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Collection Name"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap Between Tiles",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Border Thickness",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#D4AF37"
    },
    {
      "type": "header",
      "content": "Text & Typography"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Heading Font Size",
      "min": 18,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "default": "bottom",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Gold Color (hover)",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color (hover)",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Editorial Motion Grid",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "heading": "Feature"
          }
        },
        {
          "type": "tile",
          "settings": {
            "heading": "Spring"
          }
        },
        {
          "type": "tile",
          "settings": {
            "heading": "Summer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
