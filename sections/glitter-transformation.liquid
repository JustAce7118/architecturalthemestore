    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Glitter Transformation",
      "settings": {
        "title": "The Glitter Transformation",
        "before_label": "BEFORE",
        "after_label": "AFTER",
        "button_text": "Shop the Look",
        "bg_color": "#F9F7F2",
        "text_color": "#111111",
        "accent_color": "#D4AF37",
        "button_bg": "#D4AF37",
        "button_text_color": "#111111"
      }
    }
  ]
}
