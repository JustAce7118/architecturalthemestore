{%- liquid
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign button_bg = section.settings.button_bg
  assign button_text_color = section.settings.button_text_color
-%}

<div class="glitter-transformation" 
     style="background-color: {{ bg_color }}; --text-color: {{ text_color }}; --accent-color: {{ accent_color }}; --button-bg: {{ button_bg }}; --button-text: {{ button_text_color }};">
  
  <div class="glitter-transformation__container">
    <h2 class="glitter-transformation__title">{{ section.settings.title }}</h2>
    
    <div class="glitter-transformation__wrapper">
      <div class="glitter-transformation__images">
        {% if section.settings.before_image %}
          {{ section.settings.before_image | image_url: width: 1000 | image_tag: class: 'glitter-transformation__image glitter-transformation__before' }}
        {% else %}
          <div class="glitter-transformation__placeholder glitter-transformation__before">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        {% if section.settings.after_image %}
          {{ section.settings.after_image | image_url: width: 1000 | image_tag: class: 'glitter-transformation__image glitter-transformation__after' }}
        {% else %}
          <div class="glitter-transformation__placeholder glitter-transformation__after">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}

        <div class="glitter-transformation__divider">
          <div class="glitter-transformation__handle">
            <span class="glitter-transformation__handle-g">G</span>
          </div>
        </div>
      </div>

      <div class="glitter-transformation__labels">
        <span class="glitter-transformation__label glitter-transformation__label--before">{{ section.settings.before_label }}</span>
        <span class="glitter-transformation__label glitter-transformation__label--after">{{ section.settings.after_label }}</span>
      </div>

      <!-- Shop the Look Button -->
      <div class="glitter-transformation__button-wrapper" style="display: none;">
        <a href="{{ section.settings.button_link }}" class="glitter-transformation__button">
          <span class="glitter-transformation__button-text">{{ section.settings.button_text }}</span>
          <span class="glitter-transformation__shimmer"></span>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  :root {
    --handle-size: 56px;
    --handle-gold-gradient: linear-gradient(135deg, #D4AF37 0%, #F4D258 100%);
    --handle-shadow: 0 4px 20px rgba(212, 175, 55, 0.4),
                    0 0 0 1px rgba(255, 255, 255, 0.1) inset,
                    0 0 20px rgba(255, 255, 255, 0.2) inset;
    --divider-width: 3px;
  }

  /* Base Styles */
  .glitter-transformation {
    width: 100%;
    padding: 100px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ bg_color }} !important;
    background-image: radial-gradient(circle at 50% 50%, rgba(212, 175, 55, 0.05) 0%, transparent 50%);
  }

  .glitter-transformation__container {
    max-width: 1200px;
    width: 100%;
    text-align: center;
  }

  .glitter-transformation__title {
    font-size: 3.5rem;
    font-weight: 700;
    color: {{ text_color }} !important;
    margin: 0 0 60px 0;
    font-family: 'Playfair Display', Georgia, 'Garamond', serif;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .glitter-transformation__wrapper {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
  }

  /* High-Performance Clip-Path Container */
  .glitter-transformation__images {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: 66.666%; /* 3:2 aspect ratio */
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 25px 80px rgba(17, 17, 17, 0.15);
    background: linear-gradient(135deg, #f8f5f0 0%, #f1ece4 100%);
    isolation: separate; /* For better clip-path performance */
    will-change: clip-path; /* Optimize for animation */
  }

  .glitter-transformation__image,
  .glitter-transformation__placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
    transition: clip-path 0.01s ease-out; /* Fastest possible for performance */
  }

  .glitter-transformation__placeholder {
    background: linear-gradient(135deg, #e8e3d6, #d4cfc2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glitter-transformation__placeholder svg {
    width: 120px;
    height: 120px;
    opacity: 0.3;
  }

  /* Luxury Divider & Handle */
  .glitter-transformation__divider {
    position: absolute;
    top: 0;
    left: 50%;
    width: 3px;
    height: 100%;
    background: linear-gradient(180deg, 
      rgba(212, 175, 55, 0.8) 0%, 
      rgba(212, 175, 55, 1) 50%, 
      rgba(212, 175, 55, 0.8) 100%);
    cursor: ew-resize;
    transform: translateX(-50%);
    z-index: 10;
    transition: box-shadow 0.3s ease;
  }

  .glitter-transformation__divider:hover {
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.6);
  }

  .glitter-transformation__handle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, #D4AF37 0%, #F4D258 100%);
    border: 4px solid #ffffff;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: grab;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    box-shadow: 
      0 4px 20px rgba(212, 175, 55, 0.4),
      0 0 0 1px rgba(255, 255, 255, 0.1) inset,
      0 0 20px rgba(255, 255, 255, 0.2) inset;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .glitter-transformation__handle:hover {
    transform: translate(-50%, -50%) scale(1.15);
    box-shadow: 
      0 8px 30px rgba(212, 175, 55, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.2) inset,
      0 0 30px rgba(255, 255, 255, 0.3) inset;
  }

  .glitter-transformation__handle:active {
    cursor: grabbing;
    transform: translate(-50%, -50%) scale(0.95);
  }

  /* Luxury 'G' Letter */
  .glitter-transformation__handle-g {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0;
    text-shadow: 0 2px 4px rgba(17, 17, 17, 0.2);
    position: relative;
    top: -1px;
  }

  /* Labels */
  .glitter-transformation__labels {
    display: flex;
    justify-content: space-between;
    margin-top: 24px;
  }

  .glitter-transformation__label {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-color, #111111);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: 'Playfair Display', Georgia, serif;
  }

  /* Shop the Look Button */
  .glitter-transformation__button-wrapper {
    margin-top: 32px;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .glitter-transformation__button-wrapper.show {
    opacity: 1;
    transform: translateY(0);
    display: block !important;
  }

  .glitter-transformation__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 54px;
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--button-text, #111111);
    background-color: var(--button-bg, #D4AF37);
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    width: fit-content;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: 'Playfair Display', Georgia, serif;
    box-shadow: 0 8px 32px rgba(212, 175, 55, 0.3);
  }

  .glitter-transformation__button:hover {
    box-shadow: 0 12px 48px rgba(212, 175, 55, 0.5);
    transform: translateY(-2px);
  }

  /* Shimmer Effect */
  .glitter-transformation__shimmer {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.6),
      transparent
    );
    animation: glitter-shimmer 3s infinite;
  }

  @keyframes glitter-shimmer {
    0% {
      left: -100%;
    }
    50% {
      left: 100%;
    }
    100% {
      left: 100%;
    }
  }

  .glitter-transformation__button-text {
    position: relative;
    z-index: 1;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .glitter-transformation {
      padding: 80px 24px;
    }

    .glitter-transformation__title {
      font-size: 2.5rem;
      margin-bottom: 40px;
    }

    .glitter-transformation__wrapper {
      max-width: 100%;
    }

    .glitter-transformation__images {
      padding-bottom: 75%; /* 4:3 aspect ratio on mobile */
    }

    .glitter-transformation__handle {
      width: 48px;
      height: 48px;
    }

    .glitter-transformation__handle-g {
      font-size: 20px;
    }

    .glitter-transformation__button {
      padding: 16px 40px;
      font-size: 1rem;
    }

    .glitter-transformation__label {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .glitter-transformation {
      padding: 60px 16px;
    }

    .glitter-transformation__title {
      font-size: 2rem;
    }

    .glitter-transformation__images {
      padding-bottom: 100%; /* Square aspect ratio on mobile */
    }

    .glitter-transformation__handle {
      width: 40px;
      height: 40px;
    }

    .glitter-transformation__handle-g {
      font-size: 18px;
    }

    .glitter-transformation__button {
      padding: 14px 32px;
      font-size: 0.875rem;
    }

    .glitter-transformation__label {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sliders = document.querySelectorAll('.glitter-transformation__wrapper');

    sliders.forEach(function(wrapper) {
      const divider = wrapper.querySelector('.glitter-transformation__divider');
      const afterImage = wrapper.querySelector('.glitter-transformation__after');
      const buttonWrapper = wrapper.querySelector('.glitter-transformation__button-wrapper');
      let isDragging = false;
      let shopButtonShown = false;

      function moveDivider(clientX) {
        const rect = wrapper.getBoundingClientRect();
        const x = clientX - rect.left;
        const percentage = (x / rect.width) * 100;
        const constrainedPercentage = Math.min(Math.max(percentage, 0), 100);

        if (constrainedPercentage >= 0 && constrainedPercentage <= 100) {
          divider.style.left = constrainedPercentage + '%';
          afterImage.style.clipPath = `inset(0 ${100 - constrainedPercentage}% 0 0)`;
          
          // Show Shop the Look button after 80%
          if (constrainedPercentage > 80 && !shopButtonShown) {
            shopButtonShown = true;
            buttonWrapper.classList.add('show');
          } else if (constrainedPercentage <= 80 && shopButtonShown) {
            shopButtonShown = false;
            buttonWrapper.classList.remove('show');
          }
        }
      }

      function handleMouseMove(e) {
        if (!isDragging) return;
        moveDivider(e.clientX);
      }

      function handleTouchMove(e) {
        if (!isDragging) return;
        e.preventDefault();
        const touch = e.touches[0];
        moveDivider(touch.clientX);
      }

      function handleMouseDown() {
        isDragging = true;
        document.addEventListener('mousemove', handleMouseMove);
        document.addEventListener('mouseup', function() {
          isDragging = false;
          document.removeEventListener('mousemove', handleMouseMove);
        }, { once: true });
      }

      function handleTouchStart(e) {
        isDragging = true;
        document.addEventListener('touchmove', handleTouchMove);
        document.addEventListener('touchend', function() {
          isDragging = false;
          document.removeEventListener('touchmove', handleTouchMove);
        }, { once: true });
      }

      divider.addEventListener('mousedown', handleMouseDown);
      divider.addEventListener('touchstart', handleTouchStart);

      // Add click/tap functionality for the entire slider area
      wrapper.addEventListener('click', function(e) {
        if (!divider.contains(e.target)) {
          moveDivider(e.clientX);
        }
      });

      wrapper.addEventListener('touchstart', function(e) {
        if (!divider.contains(e.target)) {
          const touch = e.touches[0];
          moveDivider(touch.clientX);
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Glitter Transformation",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
