{%- liquid
  assign hotspot_color = section.settings.hotspot_color
  assign tooltip_bg = section.settings.tooltip_bg
  assign tooltip_text = section.settings.tooltip_text
  assign feature_image = section.settings.feature_image
  assign hotspot_size = section.settings.hotspot_size
-%}

<div class="glitter-hotspots" style="--hotspot-color: {{ hotspot_color }}; --tooltip-bg: {{ tooltip_bg }}; --tooltip-text: {{ tooltip_text }}; --hotspot-size: {{ hotspot_size }}px;">
  <!-- Main Image Container -->
  <div class="glitter-hotspots__image-container">
    {%- if feature_image != blank -%}
      <img src="{{ feature_image | image_url: width: 1200, height: 900 }}" alt="Product Image" class="glitter-hotspots__image">
    {%- else -%}
      <div class="glitter-hotspots__placeholder">
        {{ 'product-1' | placeholder_svg_tag: 'glitter-hotspots__placeholder-svg' }}
      </div>
    {%- endif -%}

    <!-- Hotspots (Desktop) -->
    <div class="glitter-hotspots__dots">
      {%- for block in section.blocks -%}
        <div 
          class="glitter-hotspots__dot" 
          style="left: {{ block.settings.horizontal_position }}%; top: {{ block.settings.vertical_position }}%;"
          data-hotspot-id="{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          <span class="glitter-hotspots__dot-pulse"></span>
          <div class="glitter-hotspots__tooltip glitter-hotspots__tooltip--{{ forloop.index }}">
            <h3 class="glitter-hotspots__tooltip-heading">{{ block.settings.feature_title }}</h3>
            <p class="glitter-hotspots__tooltip-description">{{ block.settings.feature_description }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- Mobile Fallback: List View -->
  <div class="glitter-hotspots__mobile-list">
    {%- for block in section.blocks -%}
      <div class="glitter-hotspots__mobile-item" {{ block.shopify_attributes }}>
        <div class="glitter-hotspots__mobile-dot"></div>
        <div class="glitter-hotspots__mobile-content">
          <h3 class="glitter-hotspots__mobile-heading">{{ block.settings.feature_title }}</h3>
          <p class="glitter-hotspots__mobile-description">{{ block.settings.feature_description }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<style>
  .glitter-hotspots {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  .glitter-hotspots__image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background-color: #f5f5f5;
  }

  .glitter-hotspots__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .glitter-hotspots__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .glitter-hotspots__placeholder-svg {
    width: 300px;
    height: 300px;
    opacity: 0.2;
  }

  /* HOTSPOTS CONTAINER */
  .glitter-hotspots__dots {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* DOT */
  .glitter-hotspots__dot {
    position: absolute;
    transform: translate(-50%, -50%);
    pointer-events: all;
    cursor: pointer;
    z-index: 10;
  }

  .glitter-hotspots__dot-pulse {
    display: block;
    width: var(--hotspot-size);
    height: var(--hotspot-size);
    border-radius: 50%;
    background-color: var(--hotspot-color);
    border: 2px solid var(--hotspot-color);
    box-shadow: 0 0 0 0 var(--hotspot-color);
    animation: hotspot-pulse 2s infinite;
  }

  @keyframes hotspot-pulse {
    0% {
      box-shadow: 0 0 0 0 var(--hotspot-color);
      opacity: 1;
    }
    70% {
      box-shadow: 0 0 0 10px rgba(212, 175, 55, 0);
      opacity: 0.8;
    }
    100% {
      box-shadow: 0 0 0 0 rgba(212, 175, 55, 0);
      opacity: 0;
    }
  }

  /* TOOLTIP */
  .glitter-hotspots__tooltip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background-color: var(--tooltip-bg);
    color: var(--tooltip-text);
    padding: 16px 20px;
    border: 1px solid var(--hotspot-color);
    border-radius: 4px;
    white-space: nowrap;
    margin-bottom: 12px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 0.875rem;
    z-index: 20;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    pointer-events: none;
    min-width: 200px;
    max-width: 280px;
    white-space: normal;
  }

  .glitter-hotspots__dot:hover .glitter-hotspots__tooltip {
    opacity: 1;
    visibility: visible;
  }

  .glitter-hotspots__tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 8px solid transparent;
    border-top-color: var(--tooltip-bg);
  }

  .glitter-hotspots__tooltip-heading {
    margin: 0 0 8px 0;
    font-family: 'Georgia', 'Garamond', serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--tooltip-text);
  }

  .glitter-hotspots__tooltip-description {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--tooltip-text);
  }

  /* MOBILE LIST */
  .glitter-hotspots__mobile-list {
    display: none;
    margin-top: 32px;
  }

  .glitter-hotspots__mobile-item {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e0e0e0;
  }

  .glitter-hotspots__mobile-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .glitter-hotspots__mobile-dot {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--hotspot-color);
    border: 1px solid var(--hotspot-color);
    margin-top: 6px;
  }

  .glitter-hotspots__mobile-content {
    flex: 1;
  }

  .glitter-hotspots__mobile-heading {
    margin: 0 0 6px 0;
    font-family: 'Georgia', 'Garamond', serif;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #111111;
  }

  .glitter-hotspots__mobile-description {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #666666;
  }

  /* RESPONSIVE: TABLET */
  @media (max-width: 768px) {
    .glitter-hotspots {
      padding: 32px 20px;
    }

    .glitter-hotspots__image-container {
      aspect-ratio: 3 / 4;
    }

    .glitter-hotspots__dot-pulse {
      width: calc(var(--hotspot-size) * 0.75);
      height: calc(var(--hotspot-size) * 0.75);
      border-width: 1.5px;
    }

    .glitter-hotspots__tooltip {
      min-width: 160px;
      padding: 12px 16px;
    }

    .glitter-hotspots__tooltip-heading {
      font-size: 0.9rem;
    }

    .glitter-hotspots__tooltip-description {
      font-size: 0.7rem;
    }
  }

  /* RESPONSIVE: MOBILE */
  @media (max-width: 480px) {
    .glitter-hotspots {
      padding: 24px 16px;
    }

    .glitter-hotspots__image-container {
      aspect-ratio: 1 / 1.2;
    }

    .glitter-hotspots__dots {
      display: none;
    }

    .glitter-hotspots__mobile-list {
      display: block;
    }

    .glitter-hotspots__dot-pulse {
      width: calc(var(--hotspot-size) * 0.62);
      height: calc(var(--hotspot-size) * 0.62);
    }
  }
</style>

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const dots = document.querySelectorAll('.glitter-hotspots__dot');
  
  dots.forEach(dot => {
    dot.addEventListener('click', function(e) {
      e.stopPropagation();
      
      // Close all other tooltips
      dots.forEach(d => {
        if (d !== dot) {
          d.querySelector('.glitter-hotspots__tooltip').style.opacity = '0';
          d.querySelector('.glitter-hotspots__tooltip').style.visibility = 'hidden';
        }
      });
      
      // Toggle current tooltip
      const tooltip = this.querySelector('.glitter-hotspots__tooltip');
      const isVisible = tooltip.style.opacity === '1';
      
      if (isVisible) {
        tooltip.style.opacity = '0';
        tooltip.style.visibility = 'hidden';
      } else {
        tooltip.style.opacity = '1';
        tooltip.style.visibility = 'visible';
      }
    });
  });
  
  // Close tooltips on outside click
  document.addEventListener('click', function() {
    dots.forEach(dot => {
      const tooltip = dot.querySelector('.glitter-hotspots__tooltip');
      tooltip.style.opacity = '0';
      tooltip.style.visibility = 'hidden';
    });
  });
});
{% endjavascript %}

{% schema %}
{
  "name": "Glitter Hotspots",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "range",
          "id": "horizontal_position",
          "label": "Horizontal Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "vertical_position",
          "label": "Vertical Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "text",
          "id": "feature_title",
          "label": "Feature Title",
          "default": "Feature Name"
        },
        {
          "type": "textarea",
          "id": "feature_description",
          "label": "Feature Description",
          "default": "Describe this feature here."
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Product Image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "hotspot_color",
      "label": "Hotspot Color",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "tooltip_bg",
      "label": "Tooltip Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "tooltip_text",
      "label": "Tooltip Text Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "hotspot_size",
      "label": "Hotspot Diameter",
      "min": 8,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Glitter Hotspots",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "horizontal_position": 25,
            "vertical_position": 35,
            "feature_title": "Volume"
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "horizontal_position": 50,
            "vertical_position": 50,
            "feature_title": "Length"
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "horizontal_position": 75,
            "vertical_position": 65,
            "feature_title": "Quality"
          }
        }
      ]
    }
  ]
}
{% endschema %}
