{% comment %}
  Blueprint Timeline
  - Horizontal project phases with vertical connectors
  - Technical date annotations and status indicators
  - Scan-line hover effect on each phase card
{% endcomment %}

<div class="blueprint-timeline">
  <div class="blueprint-timeline__header">
    <h3 class="blueprint-timeline__title">{{ section.settings.heading | default: 'PROJECT PHASES' | upcase }}</h3>
    <span class="blueprint-timeline__meta">// TOTAL_PHASES: {{ section.blocks.size }} — TIMELINE_V1.0</span>
  </div>

  <div class="blueprint-timeline__track">
    <div class="blueprint-timeline__line"></div>
    <div class="blueprint-timeline__phases">
      {% for block in section.blocks %}
        <div class="blueprint-timeline__phase {% if block.settings.is_active %}is-active{% endif %}">
          <div class="phase-marker">
            <span class="phase-marker__dot {% if block.settings.is_active %}pulse{% endif %}"></span>
            <span class="phase-marker__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          </div>

          <div class="phase-card">
            <div class="phase-card__scanner"></div>
            <div class="phase-card__label-bar">
              <span class="phase-card__date">{{ block.settings.date | default: '2025.Q1' }}</span>
              <span class="phase-card__status {% if block.settings.is_active %}status--active{% else %}status--complete{% endif %}">
                {% if block.settings.is_active %}● ACTIVE{% else %}✓ COMPLETE{% endif %}
              </span>
            </div>
            <h4 class="phase-card__title">{{ block.settings.title | default: 'PHASE TITLE' | upcase }}</h4>
            <p class="phase-card__desc">{{ block.settings.description | default: 'Phase description goes here.' }}</p>
            {% if block.settings.ref_code != blank %}
              <span class="phase-card__ref">REF: {{ block.settings.ref_code }}</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .blueprint-timeline {
    padding: 4rem 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .blueprint-timeline__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 3rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
    max-width: var(--page-width);
    margin-left: auto;
    margin-right: auto;
  }

  .blueprint-timeline__title {
    font-size: 1.2rem;
    margin: 0;
    color: var(--color-accent);
    letter-spacing: 2px;
  }

  .blueprint-timeline__meta {
    font-size: 0.7rem;
    opacity: 0.4;
  }

  .blueprint-timeline__track {
    position: relative;
    max-width: var(--page-width);
    margin: 0 auto;
    overflow-x: auto;
    padding-bottom: 1rem;
  }

  .blueprint-timeline__line {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-border);
    z-index: 0;
  }

  .blueprint-timeline__phases {
    display: flex;
    gap: 2rem;
    position: relative;
    z-index: 1;
    min-width: max-content;
  }

  .blueprint-timeline__phase {
    flex: 0 0 280px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Marker */
  .phase-marker {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 1rem;
  }

  .phase-marker__dot {
    width: 10px;
    height: 10px;
    background: var(--color-border);
    display: block;
    border: 1px solid var(--color-border);
  }

  .blueprint-timeline__phase.is-active .phase-marker__dot,
  .phase-marker__dot.pulse {
    background: var(--color-accent);
    border-color: var(--color-accent);
    animation: timeline-pulse 2s infinite;
  }

  .phase-marker__index {
    font-size: 0.6rem;
    color: var(--color-accent);
    opacity: 0.6;
    letter-spacing: 1px;
  }

  /* Card */
  .phase-card {
    width: 100%;
    border: 1px solid var(--color-border);
    background: rgba(15, 23, 42, 0.5);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }

  .phase-card:hover {
    border-color: rgba(56, 189, 248, 0.3);
  }

  .phase-card__scanner {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 0.3s;
    z-index: 2;
  }

  .phase-card:hover .phase-card__scanner {
    opacity: 1;
    animation: timeline-scan 1.5s linear infinite;
  }

  .phase-card__label-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 1rem;
    border-bottom: 1px dashed var(--color-border);
    background: rgba(56, 189, 248, 0.03);
  }

  .phase-card__date {
    font-size: 0.65rem;
    letter-spacing: 2px;
    opacity: 0.6;
  }

  .phase-card__status {
    font-size: 0.6rem;
    letter-spacing: 1px;
  }

  .status--active {
    color: var(--color-accent);
  }

  .status--complete {
    color: #4ade80;
    opacity: 0.7;
  }

  .phase-card__title {
    padding: 1rem 1rem 0.5rem;
    font-size: 0.95rem;
    letter-spacing: 1px;
    margin: 0;
  }

  .phase-card__desc {
    padding: 0 1rem 1rem;
    font-size: 0.8rem;
    opacity: 0.6;
    line-height: 1.5;
    margin: 0;
  }

  .phase-card__ref {
    display: block;
    padding: 0.5rem 1rem;
    font-size: 0.6rem;
    border-top: 1px dashed var(--color-border);
    color: var(--color-accent);
    opacity: 0.5;
    letter-spacing: 1px;
  }

  @keyframes timeline-pulse {
    0%, 100% { opacity: 0.5; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.15); }
  }

  @keyframes timeline-scan {
    0% { top: 0%; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  @media screen and (max-width: 750px) {
    .blueprint-timeline__phases {
      flex-direction: column;
      min-width: unset;
    }
    .blueprint-timeline__phase {
      flex: 0 0 auto;
    }
    .blueprint-timeline__line {
      display: none;
    }
    .blueprint-timeline__header {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "Blueprint Timeline",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PROJECT PHASES"
    }
  ],
  "blocks": [
    {
      "type": "phase",
      "name": "Phase",
      "settings": [
        {
          "type": "text",
          "id": "date",
          "label": "Date / Period",
          "default": "2025.Q1"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Phase Title",
          "default": "CONCEPT DESIGN"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Initial concept development and feasibility analysis."
        },
        {
          "type": "text",
          "id": "ref_code",
          "label": "Reference Code",
          "default": "PH-001"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Currently Active?",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blueprint Timeline",
      "blocks": [
        { "type": "phase", "settings": { "date": "2024.Q3", "title": "RESEARCH & ANALYSIS", "description": "Site surveys, material research, and environmental assessment.", "ref_code": "PH-001" } },
        { "type": "phase", "settings": { "date": "2024.Q4", "title": "CONCEPT DESIGN", "description": "Initial schematic design and client review sessions.", "ref_code": "PH-002" } },
        { "type": "phase", "settings": { "date": "2025.Q1", "title": "DEVELOPMENT", "description": "Detailed engineering drawings and structural calculations.", "ref_code": "PH-003", "is_active": true } },
        { "type": "phase", "settings": { "date": "2025.Q2", "title": "FABRICATION", "description": "Component manufacturing and quality assurance testing.", "ref_code": "PH-004" } }
      ]
    }
  ]
}
{% endschema %}
