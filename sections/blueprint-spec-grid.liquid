{% comment %}
  Blueprint Spec Grid
  - Raw Data Sheet Layout
  - High density tech specs
  - Monospace table look
{% endcomment %}

<div class="blueprint-spec-grid">
  <div class="blueprint-spec-grid__container">
    {% if section.settings.title != blank %}
      <div class="blueprint-spec-grid__header">
        <h3 class="blueprint-spec-grid__title">{{ section.settings.title | upcase }}</h3>
        <span class="blueprint-spec-grid__meta">DATA_SHEET_V1.0</span>
      </div>
    {% endif %}

    <div class="blueprint-spec-grid__table">
      {% for block in section.blocks %}
        <div class="blueprint-spec-grid__row">
          <div class="blueprint-spec-grid__cell label">
            {{ block.settings.label | upcase }}
          </div>
          <div class="blueprint-spec-grid__cell value">
            {{ block.settings.value }}
          </div>
          <div class="blueprint-spec-grid__cell code">
            {{ block.settings.code }}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .blueprint-spec-grid {
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .blueprint-spec-grid__container {
    width: 95%;
    max-width: var(--page-width);
    margin: 0 auto;
    border: 1px solid var(--color-border);
    background: rgba(15, 23, 42, 0.4); /* Dark Glass */
    backdrop-filter: blur(8px);
  }

  .blueprint-spec-grid__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
    background: rgba(56, 189, 248, 0.05); /* Very subtle cyan tint */
  }

  .blueprint-spec-grid__title {
    font-size: 1rem;
    margin: 0;
    color: var(--color-accent);
  }

  .blueprint-spec-grid__meta {
    font-size: 0.7rem;
    opacity: 0.6;
    font-family: var(--font-primary--family);
  }

  .blueprint-spec-grid__table {
    display: grid;
    /* Simulate table rows */
  }

  .blueprint-spec-grid__row {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.2s ease;
  }
  
  .blueprint-spec-grid__row:last-child {
    border-bottom: none;
  }

  .blueprint-spec-grid__row:hover {
    background: rgba(56, 189, 248, 0.1); /* Cyan highlight on hover */
  }

  .blueprint-spec-grid__cell {
    padding: 1rem;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    border-right: 1px solid var(--color-border);
  }
  
  .blueprint-spec-grid__cell:last-child {
    border-right: none;
  }

  .blueprint-spec-grid__cell.label {
    font-weight: 700;
    color: var(--color-foreground);
    opacity: 0.9;
  }

  .blueprint-spec-grid__cell.value {
    color: var(--color-foreground);
    opacity: 0.8;
  }

  .blueprint-spec-grid__cell.code {
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--color-accent);
    justify-content: flex-end;
  }

  @media screen and (max-width: 600px) {
    .blueprint-spec-grid__row {
      grid-template-columns: 1fr;
    }
    .blueprint-spec-grid__cell {
      border-right: none;
      border-bottom: 1px dashed rgba(255,255,255,0.1);
      padding: 0.5rem 1rem;
    }
    .blueprint-spec-grid__cell.code {
      justify-content: flex-start;
      padding-bottom: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Spec Grid (Data Sheet)",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "TECHNICAL SPECIFICATIONS"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Material"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Carbon Fiber Composite"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Ref Code",
          "default": "CF-X99"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spec Grid (Data Sheet)",
      "blocks": [
        { "type": "spec", "settings": {"label": "Weight", "value": "1.2kg", "code": "WT_01"}},
        { "type": "spec", "settings": {"label": "Resistance", "value": "IP68 Waterproof", "code": "RS_68"}}
      ]
    }
  ]
}
{% endschema %}
