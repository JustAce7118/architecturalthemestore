{%- liquid
  assign announcement_bg = section.settings.announcement_bg
  assign announcement_text_color = section.settings.announcement_text_color
  assign announcement_text_content = section.settings.announcement_text_content
  assign social_icon_color = section.settings.social_icon_color
  assign social_hover_color = section.settings.social_hover_color
  assign instagram_url = section.settings.instagram_url
  assign tiktok_url = section.settings.tiktok_url
  assign pinterest_url = section.settings.pinterest_url
  assign utility_link_text = section.settings.utility_link_text
  assign utility_link_url = section.settings.utility_link_url
  assign header_bg = section.settings.header_bg
  assign logo_image = section.settings.logo_image
  assign brand_text = section.settings.brand_text
  assign logo_width = section.settings.logo_width
  assign header_padding = section.settings.header_padding
  assign search_icon_color = section.settings.search_icon_color
  assign cart_icon_color = section.settings.cart_icon_color
  assign gold_bar_bg = section.settings.gold_bar_bg
  assign gold_bar_text_color = section.settings.gold_bar_text_color
  assign gold_bar_text = section.settings.gold_bar_text
  assign sticky_header = section.settings.sticky_header
  assign border_color = section.settings.border_color
-%}

<style>
  :root {
    --social-hover-color: {{ social_hover_color }};
    --border-color: {{ border_color }};
  }
</style>

<!-- ANNOUNCEMENT BAR -->
<div class="glitter-header__announcement" style="background-color: {{ announcement_bg }}; color: {{ announcement_text_color }};">
  <div class="glitter-header__announcement-inner">
    <!-- LEFT: Social Icons -->
    <div class="glitter-header__social-icons">
      {%- if instagram_url != blank -%}
        <a href="{{ instagram_url }}" class="glitter-header__social-icon" style="color: {{ social_icon_color }};" title="Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <circle cx="17.5" cy="6.5" r="1.5"></circle>
          </svg>
        </a>
      {%- endif -%}
      
      {%- if tiktok_url != blank -%}
        <a href="{{ tiktok_url }}" class="glitter-header__social-icon" style="color: {{ social_icon_color }};" title="TikTok">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
          </svg>
        </a>
      {%- endif -%}
      
      {%- if pinterest_url != blank -%}
        <a href="{{ pinterest_url }}" class="glitter-header__social-icon" style="color: {{ social_icon_color }};" title="Pinterest">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M8 12s0-4 4-4 4 3 4 4-1 6-4 6-4-2-4-6"></path>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <!-- CENTER: Announcement Text -->
    <p class="glitter-header__announcement-text">{{ announcement_text_content }}</p>

    <!-- RIGHT: Utility Link -->
    {%- if utility_link_url != blank -%}
      <a href="{{ utility_link_url }}" class="glitter-header__utility-link" style="color: {{ announcement_text_color }};">{{ utility_link_text }}</a>
    {%- endif -%}
  </div>
</div>

<!-- MAIN HEADER -->
<header class="glitter-header {% if sticky_header %}glitter-header--sticky{% endif %}" style="background-color: {{ header_bg }}; padding: {{ header_padding }}px 40px;">
  <div class="glitter-header__content">
    <!-- Logo or Brand Text -->
    <div class="glitter-header__logo-container" style="width: {{ logo_width }}px;">
      {%- if logo_image != blank -%}
        <img src="{{ logo_image | image_url: width: 1200 }}" alt="{{ shop.name }}" class="glitter-header__logo-image">
      {%- else -%}
        <span class="glitter-header__brand-text">{{ brand_text }}</span>
      {%- endif -%}
    </div>

    <!-- Icons: Search & Cart -->
    <div class="glitter-header__icons">
      <button class="glitter-header__icon glitter-header__icon--search" style="color: {{ search_icon_color }};" title="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
      
      <button class="glitter-header__icon glitter-header__icon--cart" style="color: {{ cart_icon_color }};" title="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- GOLD BAR -->
<div class="glitter-header__gold-bar" style="background-color: {{ gold_bar_bg }}; color: {{ gold_bar_text_color }};">
  <p class="glitter-header__gold-bar-text">{{ gold_bar_text }}</p>
</div>

<style>
  /* ANNOUNCEMENT BAR */
  .glitter-header__announcement {
    width: 100%;
    padding: 12px 24px;
  }

  .glitter-header__announcement-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .glitter-header__social-icons {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  .glitter-header__social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .glitter-header__social-icon:hover {
    color: var(--social-hover-color);
    transform: translateY(-2px);
  }

  .glitter-header__announcement-text {
    flex: 1;
    margin: 0;
    text-align: center;
    font-family: 'Segoe UI', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .glitter-header__utility-link {
    flex-shrink: 0;
    font-family: 'Segoe UI', sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-decoration: none;
    padding: 6px 12px;
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
  }

  .glitter-header__utility-link:hover {
    color: var(--social-hover-color);
    border-bottom-color: var(--social-hover-color);
  }

  /* MAIN HEADER */
  .glitter-header {
    width: 100%;
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border-color);
  }

  .glitter-header--sticky {
    position: sticky;
    top: 0;
    box-shadow: 0 2px 8px rgba(17, 17, 17, 0.04);
  }

  .glitter-header__content {
    width: 100%;
    max-width: 1400px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .glitter-header__logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glitter-header__logo-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .glitter-header__brand-text {
    font-family: 'Georgia', 'Garamond', serif;
    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .glitter-header__icons {
    position: absolute;
    right: 40px;
    display: flex;
    gap: 20px;
  }

  .glitter-header__icon {
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .glitter-header__icon:hover {
    color: #D4AF37;
    transform: translateY(-1px);
  }

  /* GOLD BAR */
  .glitter-header__gold-bar {
    width: 100%;
    padding: 16px 24px;
    text-align: center;
  }

  .glitter-header__gold-bar-text {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  /* RESPONSIVE: TABLET */
  @media (max-width: 768px) {
    .glitter-header__announcement-inner {
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
    }

    .glitter-header__social-icons {
      order: 1;
      width: 100%;
      justify-content: center;
    }

    .glitter-header__announcement-text {
      order: 2;
      width: 100%;
      font-size: 0.7rem;
    }

    .glitter-header__utility-link {
      order: 3;
      width: 100%;
      text-align: center;
    }

    .glitter-header {
      padding: 30px 20px;
    }

    .glitter-header__icons {
      right: 20px;
      gap: 16px;
    }

    .glitter-header__gold-bar {
      padding: 12px 16px;
    }

    .glitter-header__gold-bar-text {
      font-size: 0.8rem;
    }
  }

  /* RESPONSIVE: MOBILE */
  @media (max-width: 480px) {
    .glitter-header__announcement {
      padding: 8px 16px;
    }

    .glitter-header__announcement-inner {
      gap: 8px;
    }

    .glitter-header__social-icons {
      gap: 12px;
    }

    .glitter-header__announcement-text {
      font-size: 0.65rem;
    }

    .glitter-header__utility-link {
      font-size: 0.65rem;
      padding: 4px 8px;
    }

    .glitter-header {
      padding: 20px 16px;
    }

    .glitter-header__icons {
      right: 16px;
      gap: 12px;
    }

    .glitter-header__icon {
      width: 24px;
      height: 24px;
    }

    .glitter-header__gold-bar {
      padding: 10px 12px;
    }

    .glitter-header__gold-bar-text {
      font-size: 0.75rem;
    }
  }
</style>

{% schema %}
{
  "name": "Glitter Header",
  "settings": [
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "text",
      "id": "announcement_text_content",
      "label": "Text",
      "default": "FREE SHIPPING ON ORDERS OVER $100"
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Social Icons"
    },
    {
      "type": "color",
      "id": "social_icon_color",
      "label": "Icon Color",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "social_hover_color",
      "label": "Icon Hover Color",
      "default": "#D4AF37"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL (leave blank to hide)"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL (leave blank to hide)"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL (leave blank to hide)"
    },
    {
      "type": "header",
      "content": "Utility Link"
    },
    {
      "type": "text",
      "id": "utility_link_text",
      "label": "Text",
      "default": "Track Order"
    },
    {
      "type": "url",
      "id": "utility_link_url",
      "label": "URL (leave blank to hide)"
    },
    {
      "type": "header",
      "content": "Logo & Header"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand Text (fallback if no logo)",
      "default": "GLITTER"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width",
      "min": 100,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "header_padding",
      "label": "Padding (Top & Bottom)",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "color",
      "id": "search_icon_color",
      "label": "Search Icon Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "cart_icon_color",
      "label": "Cart Icon Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Gold Bar"
    },
    {
      "type": "text",
      "id": "gold_bar_text",
      "label": "Text",
      "default": "Luxury Hair Extensions · Premium Quality · Free Consultations"
    },
    {
      "type": "color",
      "id": "gold_bar_bg",
      "label": "Background Color",
      "default": "#D4AF37"
    },
    {
      "type": "color",
      "id": "gold_bar_text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Make Header Sticky",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Glitter Header"
    }
  ]
}
{% endschema %}
