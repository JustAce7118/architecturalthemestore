{% comment %}
  Blueprint Product Card
  - Strict 1px border
  - Monospace font
  - No Sale Badge
  - Image + Title + Price only
{% endcomment %}

<div class="product-card">
  <div class="product-card__image-wrapper">
    <a href="{{ product.url }}" class="product-card__link">
      {% if product.featured_image %}
        {% render 'image',
          class: 'product-card__image',
          image: product.featured_image,
          width: 600,
          height: 600,
          crop: 'center'
        %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__image placeholder-svg' }}
      {% endif %}
    </a>
  </div>
  
  <div class="product-card__info">
    <div class="product-card__header">
      <h3 class="product-card__title">
        <a href="{{ product.url }}">
          {{ product.title | upcase }}
        </a>
      </h3>
      <span class="product-card__sku">REF: {{ product.id | slice: -4, 4 }}</span>
    </div>
    
    <div class="product-card__footer">
      <span class="product-card__price">{{ product.price | money }}</span>
    </div>
  </div>
</div>

<style>
  .product-card {
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    height: 100%;
  .product-card {
    border: 1px solid var(--color-border);
    position: relative;
    background: var(--color-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
  }
  
  .product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.6); /* Deep Shadow */
    border-color: var(--color-accent); /* Glow on hover */
  }

  .product-card__image-wrapper {
    border-bottom: 1px solid var(--color-border);
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  
  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__info {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
    justify-content: space-between;
  }

  .product-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  .product-card__title {
    font-size: 1rem;
    margin: 0;
    line-height: 1.2;
    font-weight: 700;
  }

  .product-card__title a {
    text-decoration: none;
  }

  .product-card__sku {
    font-size: 0.7rem;
    opacity: 0.7;
    white-space: nowrap;
  }

  .product-card__footer {
    border-top: 1px solid var(--color-border);
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    text-align: right;
  }

  .product-card__price {
    font-size: 1rem;
    font-weight: 400;
  }
</style>
